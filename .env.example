# Copy to .env and fill in. Never commit .env -- it is gitignored.
#
# Only ANTHROPIC_API_KEY is required, and only for live runs. The committed
# evaluation reproduces without it:  make eval-replay

ANTHROPIC_API_KEY=

# Infrastructure -- these defaults match docker-compose.yml
DATABASE_URL=postgresql://preauth:preauth@localhost:5432/preauth
REDIS_URL=redis://localhost:6379/0

# Models
EXTRACTION_MODEL=claude-sonnet-5
ADJUDICATION_MODEL=claude-sonnet-5
CRITIC_MODEL=claude-haiku-4-5-20251001

# Decision policy -- see packages/core/config.py for what each one gates
FIELD_REREAD_THRESHOLD=0.85
FIELD_CONFIDENCE_FLOOR=0.95
ENTITY_MATCH_FLOOR=0.92
AUTO_RELEASE_COST_CEILING=2500
NECESSITY_CONFIDENCE_FLOOR=0.80
